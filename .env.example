# Hostname of the PostgreSQL server (defaults to "localhost" if unset)
DB_HOST=localhost
# Port the PostgreSQL server listens on (defaults to "5432" if unset)
DB_PORT=5432
# Username used to authenticate against the PostgreSQL database
DB_USERNAME=flowbank
# Password used to authenticate against the PostgreSQL database
DB_PASSWORD=change-me
# Name of the PostgreSQL database the API connects to
DB_NAME=flowbank
